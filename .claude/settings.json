{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-status-sync.ps1) -Mode reasoning; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-usage-sync.ps1); exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode|ask_user|exit_plan_mode",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-status-sync.ps1) -Mode need_user_action; exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-status-sync.ps1) -Mode reasoning; exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-status-sync.ps1) -Mode allow_action; exit 0'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-status-sync.ps1) -Mode need_user_action; exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-status-sync.ps1) -Mode classify-stop; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '& (Join-Path $(if($env:CLAUDE_PROJECT_DIR){$env:CLAUDE_PROJECT_DIR}else{$PWD.Path}) .github/hooks/ai-helper-usage-sync.ps1); exit 0'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
